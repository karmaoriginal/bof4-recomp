# Only the port, its tools and the notes are tracked. The disc image, what is
# extracted or generated from it (disc/, overlays/, port/src/rec/), the Ghidra
# project, saves, builds and debug output stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/setup.sh
!/setup.bat
!/docs/
!/tools/
!/tests/
!/patches/
!/android/
!/ps-recomp
!/.gitmodules
/tests/local/
!/port/
/port/*
!/port/build.sh
!/port/build.bat
!/port/src/
/port/src/rec/
/port/.ps-recomp/
/android/build/
/android/.gradle/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/android/sdl2/
/android/app/src/main/jniLibs/
/android/app/src/main/java/org/libsdl/
/android/*.apk
/android/*.aab
/tools/bof4tools
/tools/bof4tools.exe
__pycache__/
