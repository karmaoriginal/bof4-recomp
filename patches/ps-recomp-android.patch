+open_cue_file :: proc(dir, name: string) -> (^os.File, bool) {
+	path, _ := filepath.join({dir, name}, context.temp_allocator)
+	if f, err := os.open(path); err == nil {
+		return f, true
+	}
+	base := name
+	if i := strings.last_index_any(base, "/\\"); i >= 0 {
+		base = base[i + 1:]
+	}
+	if base != name {
+		path2, _ := filepath.join({dir, base}, context.temp_allocator)
+		if f, err := os.open(path2); err == nil {
+			return f, true
+		}
+	}
+	search_dir := dir != "" ? dir : "."
+	if entries, derr := os.read_all_directory_by_path(search_dir, context.temp_allocator); derr == nil {
+		for e in entries {
+			if e.type != .Directory && strings.equal_fold(e.name, base) {
+				if f, err := os.open(e.fullpath); err == nil {
+					return f, true
+				}
+			}
+		}
+	}
+	fmt.eprintln("disc: cannot open", path)
+	return nil, false
