+// Bitmask of 16-row VRAM bands modified since last cleared (32 * 16 = 512 rows).
+vram_dirty_bands: u32 = ~u32(0)
+
+// Mark VRAM rows y0..=y1 as modified.
+vram_mark_bands :: #force_inline proc(y0, y1: i32) {
+	if y1 < y0 || y0 < 0 || y1 >= VRAM_H {
+		vram_dirty_bands = ~u32(0)
+		return
+	}
+	b0 := u32(y0 >> 4)
+	b1 := u32(y1 >> 4)
+	if b1 >= 31 {
+		vram_dirty_bands |= (~u32(0)) << b0
+	} else {
+		vram_dirty_bands |= ((u32(1) << (b1 - b0 + 1)) - 1) << b0
+	}
+}
+
+// Band bitmask covering display rows y ..< y + h (conservatively all bands on wrap).
+vram_display_mask :: #force_inline proc(y, h: i32) -> u32 {
+	if h <= 0 || y < 0 || y + h > VRAM_H {
+		return ~u32(0)
+	}
+	b0 := u32(y >> 4)
+	b1 := u32((y + h - 1) >> 4)
+	if b1 >= 31 {
+		return (~u32(0)) << b0
+	}
+	return ((u32(1) << (b1 - b0 + 1)) - 1) << b0
+}
